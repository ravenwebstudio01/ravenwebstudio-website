# Copy to .env for local development. Never commit real values.
# In production set these in your host's secret manager (e.g. Vercel → Project → Settings → Environment Variables).

# --- Core ------------------------------------------------------------------
# Public base URL without trailing slash (used for canonical URLs, sitemap, e-mail links)
SITE_URL=http://localhost:3000
# PostgreSQL connection string (local docker-compose default shown)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ravenwebstudio
# disable | require (encrypted, no CA check) | verify (encrypted + CA check, set DATABASE_CA_CERT)
DATABASE_SSL=disable
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=5
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Leave empty: secure cookies are on automatically in production. Set "false" only for plain-HTTP testing.
COOKIE_SECURE=
# Set "true" when running behind your own reverse proxy (Caddy/Nginx) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
# Show records flagged as sample content (development/preview only; keep false in production)
SHOW_SAMPLE_CONTENT=true

# --- E-mail (any SMTP provider; leave SMTP_HOST empty to disable) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# e.g. "RavenWebStudio <hello@your-domain.eu>" — must be a sender your provider has verified
MAIL_FROM=

# --- Media storage -----------------------------------------------------------
# local (files in STORAGE_LOCAL_DIR) or s3 (any S3-compatible bucket; required on Vercel)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix of the bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/media
MEDIA_PUBLIC_BASE_URL=

# --- Analytics & search (the admin Settings page can also set these) ---------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Scheduled jobs ----------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/maintenance
CRON_SECRET=
